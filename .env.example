# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ===== ISB DEV Environment =====
APP_URL_ISB_DEV=http://localhost:3000
API_BASE_URL_ISB_DEV=http://localhost:4000/api
APP_USER_ISB_DEV=dev_user
APP_PASSWORD_ISB_DEV=dev_password
APP_API_KEY_ISB_DEV=dev_api_key
APP_TOKEN_URL_ISB_DEV=http://localhost:4000/token
DB_HOST_ISB_DEV=localhost
DB_NAME_ISB_DEV=test_db

# ===== ISB QA Environment =====
APP_URL_ISB_QA=http://qa.example.com
API_BASE_URL_ISB_QA=http://api-qa.example.com
APP_USER_ISB_QA=qa_user
APP_PASSWORD_ISB_QA=qa_password
APP_API_KEY_ISB_QA=qa_api_key
APP_TOKEN_URL_ISB_QA=http://auth-qa.example.com/token
DB_HOST_ISB_QA=db-qa.example.com
DB_NAME_ISB_QA=isb_qa

# ===== ISB UAT Environment =====
APP_URL_ISB_UAT=http://uat.example.com
API_BASE_URL_ISB_UAT=http://api-uat.example.com
APP_USER_ISB_UAT=uat_user
APP_PASSWORD_ISB_UAT=uat_password
APP_API_KEY_ISB_UAT=uat_api_key
APP_TOKEN_URL_ISB_UAT=http://auth-uat.example.com/token
DB_HOST_ISB_UAT=db-uat.example.com
DB_NAME_ISB_UAT=isb_uat

# ===== ISB PROD Environment =====
APP_URL_ISB_PROD=http://prod.example.com
API_BASE_URL_ISB_PROD=http://api-prod.example.com
APP_USER_ISB_PROD=prod_user
APP_PASSWORD_ISB_PROD=prod_password
APP_API_KEY_ISB_PROD=prod_api_key
APP_TOKEN_URL_ISB_PROD=http://auth-prod.example.com/token
DB_HOST_ISB_PROD=db-prod.example.com
DB_NAME_ISB_PROD=isb_prod

# ===== Test Execution Settings =====
BROWSER=chromium
HEADLESS=false
TIMEOUT=30000
RETRY_COUNT=2
LOG_LEVEL=debug
REPORT_FORMAT=html,json

# ===== AI/LLM Configuration =====
AI_API_KEY=your_openai_api_key_here
AI_PROVIDER=openai
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Default Environment =====
DEFAULT_ENV=ISB_DEV
