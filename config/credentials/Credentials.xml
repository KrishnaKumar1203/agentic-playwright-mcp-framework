<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Credentials Configuration
  
  IMPORTANT: Do NOT commit actual credentials to this file.
  Use environment variables instead:
  
  Example:
  export APP_USER_ISB_DEV=your_dev_user
  export APP_PASSWORD_ISB_DEV=your_dev_password
  export APP_API_KEY_ISB_DEV=your_dev_api_key
  export APP_TOKEN_URL_ISB_DEV=https://your-auth-server/token
-->
<Credentials>
    <!-- ISB Development Credentials (from environment variables) -->
    <Environment name="ISB_DEV">
        <Credential>
            <UserID>${APP_USER_ISB_DEV}</UserID>
            <Password>${APP_PASSWORD_ISB_DEV}</Password>
            <ApiKey>${APP_API_KEY_ISB_DEV}</ApiKey>
            <TokenURL>${APP_TOKEN_URL_ISB_DEV}</TokenURL>
        </Credential>
    </Environment>
    
    <!-- ISB QA Credentials (from environment variables) -->
    <Environment name="ISB_QA">
        <Credential>
            <UserID>${APP_USER_ISB_QA}</UserID>
            <Password>${APP_PASSWORD_ISB_QA}</Password>
            <ApiKey>${APP_API_KEY_ISB_QA}</ApiKey>
            <TokenURL>${APP_TOKEN_URL_ISB_QA}</TokenURL>
        </Credential>
    </Environment>
    
    <!-- ISB UAT Credentials (from environment variables) -->
    <Environment name="ISB_UAT">
        <Credential>
            <UserID>${APP_USER_ISB_UAT}</UserID>
            <Password>${APP_PASSWORD_ISB_UAT}</Password>
            <ApiKey>${APP_API_KEY_ISB_UAT}</ApiKey>
            <TokenURL>${APP_TOKEN_URL_ISB_UAT}</TokenURL>
        </Credential>
    </Environment>
    
    <!-- ISB Production Credentials (from environment variables) -->
    <Environment name="ISB_PROD">
        <Credential>
            <UserID>${APP_USER_ISB_PROD}</UserID>
            <Password>${APP_PASSWORD_ISB_PROD}</Password>
            <ApiKey>${APP_API_KEY_ISB_PROD}</ApiKey>
            <TokenURL>${APP_TOKEN_URL_ISB_PROD}</TokenURL>
        </Credential>
    </Environment>
</Credentials>
